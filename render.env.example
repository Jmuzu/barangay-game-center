# Render Web Service: barangay-game-center (Next.js)
NODE_ENV=production
PORT=3100

# Public application origins
BARANGAY_PLATFORM_URL=https://barangay-platform-35mj.onrender.com
GAME_CENTER_BASE_URL=https://barangay-game-center.onrender.com

# Replace with the public URL of the separately deployed NestJS API service.
GAME_CENTER_API_URL=https://replace-with-game-center-api-service.onrender.com

# Use the same newly generated 32+ byte secret on the platform, this web service, and the API.
GAME_CENTER_SSO_SECRET=replace-with-one-shared-random-secret
