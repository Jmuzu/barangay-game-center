# PayMongo sandbox only. Use an sk_test_ key; live keys are rejected.
PAYMONGO_SECRET_KEY=
# Test-mode webhook endpoint secret from the PayMongo Dashboard.
PAYMONGO_TEST_WEBHOOK_SECRET=
# Public HTTPS tunnel URL for local webhook delivery, e.g. https://example-tunnel.ngrok-free.app
GAME_CENTER_BASE_URL=http://localhost:3100

# Parent-platform single sign-on. Configure the same random 32+ byte secret in both apps.
GAME_CENTER_SSO_SECRET=replace-with-the-same-random-secret-in-both-apps
BARANGAY_PLATFORM_URL=http://localhost:3000
GAME_CENTER_API_URL=http://localhost:3200
